# ==============================================================================
# 12-FACTOR CLOUD CONFIGURATION (.env.example)
# Copia este archivo a `.env.local` si deseas personalizar secretos en local.
# En Google Cloud Run se inyectan desde Google Secret Manager.
# ==============================================================================

# Clave maestra para firmar cookies de sesión SSO (HMAC-SHA256)
AUTH_SECRET="resolvedesk-enterprise-local-secret-key-2026"

# Secreto para verificar cabeceras `Stripe-Signature` en /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_resolvedesk_local_test_2026"

# Opcional: API Key gratuita de Google AI Studio para activar Gemini 2.5 Flash en la nube.
# Si se deja vacío, la app conmuta automáticamente al motor NLP local (Graceful Fallback).
GEMINI_API_KEY=""
